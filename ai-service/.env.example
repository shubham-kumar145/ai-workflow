# ---- OpenAI ----
# Leave OPENAI_API_KEY empty to run in MOCK mode: every agent still runs,
# writes real files and QA still executes real tests - only the LLM is faked.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Express backend ----
BACKEND_URL=http://localhost:4000
# MUST be identical to the value in backend/.env
INTERNAL_SERVICE_SECRET=dev-internal-secret-change-me

# ---- Database (READ-ONLY reflection; Prisma owns the schema) ----
DATABASE_URL=postgresql+psycopg://aiworkflow:aiworkflow@localhost:5432/aiworkflow

# ---- Agent limits ----
MAX_SELF_REPAIR_RETRIES=6

# ---- Generated code workspace ----
WORKSPACE_ROOT=./workspaces
# subprocess = run tests directly (fast, fine for local demos)
# docker     = run tests inside a throwaway container (use for untrusted code)
QA_SANDBOX=subprocess
QA_TIMEOUT_SECONDS=120
STAGING_PORT_START=7100
