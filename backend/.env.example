# ---- Database (Prisma owns this schema) ----
DATABASE_URL="postgresql://aiworkflow:aiworkflow@localhost:5432/aiworkflow?schema=public"

# ---- Server ----
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- AI service ----
AI_SERVICE_URL=http://localhost:8000
# MUST be identical to the value in ai-service/.env
INTERNAL_SERVICE_SECRET=dev-internal-secret-change-me

# ---- Seed users (npm run seed) ----
SEED_ADMIN_EMAIL=admin@aiworkflow.dev
SEED_ADMIN_PASSWORD=admin1234
SEED_CLIENT_EMAIL=client@aiworkflow.dev
SEED_CLIENT_PASSWORD=client1234
